              "mode": "raw",
              "raw": "{\n  \"ApplicationName\": \"Rz6WNqa\",\n  \"ApplicationMaintenanceConfigurationUpdate\": {\n    \"ApplicationMaintenanceWindowStartTimeUpdate\": \"07:45\"\n  }\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
